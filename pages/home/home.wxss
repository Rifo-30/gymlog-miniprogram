.home-page {
  padding-bottom: 28rpx;
}

.active-card {
  border-color: rgba(199, 255, 61, 0.30);
}

.live-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--primary);
  box-shadow: 0 0 0 8rpx var(--primary-soft);
}

.active-label {
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
}

.active-arrow {
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 650;
}

.hero-card {
  padding: 34rpx 30rpx 28rpx;
  background: linear-gradient(145deg, var(--surface) 0%, var(--surface-2) 100%);
}

.hero-kicker {
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.quick-row {
  display: flex;
  gap: 14rpx;
}

.quick-item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  color: var(--text-2);
  font-size: 23rpx;
}

.weekly-volume {
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 700;
}

.recent-item {
  cursor: pointer;
  transition: background 120ms ease;
}

.recent-item:active,
.quick-item:active,
.active-card:active {
  background: var(--surface-2);
}

.recent-name {
  font-size: 30rpx;
  font-weight: 650;
}

.recent-volume {
  color: var(--text-2);
  font-size: 23rpx;
}

.home-foot {
  padding: 12rpx 0 32rpx;
}
