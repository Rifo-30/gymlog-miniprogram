<view class="page theme-{{theme}} template-edit-page">
  <view class="page-top">
    <view class="h1">{{isEditing ? '编辑模板' : '新建模板'}}</view>
    <view class="muted small mt-8">先确定动作和组次目标，重量会在训练时按历史表现建议。</view>
  </view>

  <view class="card mt-24">
    <view class="field-label">模板名称</view>
    <input class="input" maxlength="30" placeholder="例如：周一胸肩、腿日 A" placeholder-class="input-placeholder" value="{{name}}" bindinput="onNameInput" />
    <view class="field-label mt-16">模板备注</view>
    <textarea class="textarea" maxlength="500" placeholder="例如：热身 10 分钟，最后做 10 分钟有氧" placeholder-class="input-placeholder" value="{{note}}" bindinput="onNoteInput" />
  </view>

  <view class="section-head">
    <view>
      <view class="section-title">动作与目标</view>
      <view class="section-sub">顺序、目标组数和次数都会带入训练</view>
    </view>
  </view>

  <view wx:if="{{exercises.length}}" class="template-edit-list">
    <view wx:for="{{exercises}}" wx:key="exerciseId" class="card edit-exercise-card">
      <view class="row between">
        <view class="grow">
          <view class="edit-exercise-name">{{item.name}}</view>
          <view class="muted tiny mt-8">{{item.muscle}} · {{item.equipment}}</view>
        </view>
        <view class="edit-exercise-more" data-index="{{index}}" bindtap="openExerciseMenu">···</view>
      </view>

      <view wx:if="{{item.type === 'cardio'}}" class="target-grid mt-16">
        <view class="target-field">
          <view class="field-label">目标时长 (分钟)</view>
          <input class="target-input num" type="number" value="{{item.targetDurationMin}}" data-index="{{index}}" data-field="targetDurationMin" bindinput="onTargetInput" />
        </view>
      </view>

      <view wx:else class="target-grid mt-16">
        <view class="target-field">
          <view class="field-label">目标组数</view>
          <input class="target-input num" type="number" value="{{item.targetSets}}" data-index="{{index}}" data-field="targetSets" bindinput="onTargetInput" />
        </view>
        <view wx:if="{{item.type === 'weight_reps' || item.type === 'reps'}}" class="target-field">
          <view class="field-label">每组次数</view>
          <input class="target-input num" type="number" value="{{item.targetReps}}" data-index="{{index}}" data-field="targetReps" bindinput="onTargetInput" />
        </view>
        <view wx:else class="target-field">
          <view class="field-label">每组时长 (分钟)</view>
          <input class="target-input num" type="number" value="{{item.targetDurationMin}}" data-index="{{index}}" data-field="targetDurationMin" bindinput="onTargetInput" />
        </view>
      </view>

      <view class="target-grid mt-12">
        <view class="target-field">
          <view class="field-label">组间休息 (秒)</view>
          <input class="target-input num" type="number" value="{{item.restSeconds}}" data-index="{{index}}" data-field="restSeconds" bindinput="onTargetInput" />
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty mt-16">
    <view class="empty-title">模板还是空的</view>
    <view class="empty-desc">添加动作后，再设置每个动作的目标组数和次数。</view>
  </view>

  <button class="btn btn-ghost btn-block mt-24" bindtap="addExercise">＋ 添加动作</button>

  <view class="template-edit-bottom">
    <button class="btn btn-primary btn-block" bindtap="saveTemplate">保存模板</button>
  </view>
</view>
