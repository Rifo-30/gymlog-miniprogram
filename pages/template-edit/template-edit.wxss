.template-edit-page {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

.edit-exercise-card {
  padding: 24rpx;
}

.template-edit-list .edit-exercise-card + .edit-exercise-card {
  margin-top: 16rpx;
}

.edit-exercise-name {
  font-size: 30rpx;
  font-weight: 700;
}

.edit-exercise-more {
  width: 54rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: var(--surface-2);
  color: var(--muted);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.target-grid {
  display: flex;
  gap: 14rpx;
}

.target-field {
  flex: 1;
  min-width: 0;
}

.target-input {
  width: 100%;
  height: 72rpx;
  padding: 0 16rpx;
  border-radius: 18rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  color: var(--text);
  font-size: 27rpx;
  font-weight: 650;
}

.template-edit-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(11, 13, 16, 0) 0%, var(--bg) 28%);
}

.template-edit-bottom .btn {
  box-shadow: 0 14rpx 36rpx var(--shadow);
}
