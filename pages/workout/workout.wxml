<view class="page theme-{{theme}} workout-page">
  <view wx:if="{{workout}}">
    <view class="workout-head">
      <view class="grow">
        <view class="tiny muted">{{isEditing ? '编辑训练记录' : '训练进行中'}}</view>
        <view class="h1 mt-8">{{workout.name}}</view>
        <view class="row gap-12 mt-8">
          <view class="tiny muted num">{{elapsedLabel}}</view>
          <view class="tiny muted">{{workout.exercises.length}} 个动作</view>
          <view class="tiny muted">{{totalSets}} 组完成</view>
          <view wx:if="{{cardioCount}}" class="tiny muted">{{cardioCount}} 项有氧</view>
        </view>
      </view>
      <view class="auto-save">自动保存</view>
    </view>

    <view wx:if="{{!workout.exercises.length}}" class="empty card mt-24">
      <view class="empty-title">今天练什么？</view>
      <view class="empty-desc">添加第一个动作，开始记录重量、次数和组数。</view>
      <button class="btn btn-primary mt-20" bindtap="addExercise">添加动作</button>
    </view>

    <block wx:for="{{workout.exercises}}" wx:key="id" wx:for-item="exercise" wx:for-index="ei">
      <view class="card exercise-card mt-24">
        <view class="exercise-head" data-ex="{{ei}}" bindtap="openExerciseMenu">
          <view class="grow">
            <view class="exercise-name">{{exercise.name}}</view>
            <view class="muted tiny mt-8">{{exercise.muscle}} · {{exercise.equipment}}</view>
          </view>
          <view class="more-btn">···</view>
        </view>

        <view wx:if="{{exercise.lastHint}}" class="last-hint mt-12">上次 {{exercise.lastHint}}</view>

        <block wx:if="{{exercise.isCardio}}">
          <view class="cardio-top mt-16">
            <view class="segmented cardio-mode">
              <view class="segment {{exercise.cardio.mode === 'steady' ? 'active' : ''}}" data-ex="{{ei}}" data-mode="steady" bindtap="setCardioMode">持续</view>
              <view class="segment {{exercise.cardio.mode === 'interval' ? 'active' : ''}}" data-ex="{{ei}}" data-mode="interval" bindtap="setCardioMode">间歇</view>
            </view>
            <view class="pill {{exercise.completed ? 'pill-primary' : ''}}">{{exercise.completed ? '已记录' : '待记录'}}</view>
          </view>

          <view wx:if="{{exercise.cardio.mode === 'steady'}}" class="cardio-main-grid mt-16">
            <view class="cardio-field">
              <view class="field-label">时长</view>
              <view class="time-input-row">
                <input class="time-input num" type="number" value="{{exercise.cardio.durationMin}}" data-ex="{{ei}}" data-field="durationMin" bindinput="onCardioInput" bindblur="persistWorkout" />
                <text class="time-unit">分</text>
                <input class="time-input num" type="number" value="{{exercise.cardio.durationSecPart}}" data-ex="{{ei}}" data-field="durationSecPart" bindinput="onCardioInput" bindblur="persistWorkout" />
                <text class="time-unit">秒</text>
              </view>
            </view>
            <view wx:if="{{exercise.cardioMeta.showDistance}}" class="cardio-field">
              <view class="field-label">距离 (km)</view>
              <input class="compact-input num" type="digit" value="{{exercise.cardio.distanceKmDisplay}}" data-ex="{{ei}}" data-field="distanceKm" bindinput="onCardioInput" bindblur="persistWorkout" />
            </view>
          </view>

          <view wx:else class="cardio-interval-grid mt-16">
            <view class="cardio-field">
              <view class="field-label">回合</view>
              <input class="compact-input num" type="number" value="{{exercise.cardio.rounds}}" data-ex="{{ei}}" data-field="rounds" bindinput="onCardioInput" bindblur="persistWorkout" />
            </view>
            <view class="cardio-field">
              <view class="field-label">工作</view>
              <view class="time-input-row">
                <input class="time-input num" type="number" value="{{exercise.cardio.workMin}}" data-ex="{{ei}}" data-field="workMin" bindinput="onCardioInput" bindblur="persistWorkout" />
                <text class="time-unit">分</text>
                <input class="time-input num" type="number" value="{{exercise.cardio.workSecPart}}" data-ex="{{ei}}" data-field="workSecPart" bindinput="onCardioInput" bindblur="persistWorkout" />
                <text class="time-unit">秒</text>
              </view>
            </view>
            <view class="cardio-field">
              <view class="field-label">休息</view>
              <view class="time-input-row">
                <input class="time-input num" type="number" value="{{exercise.cardio.restMin}}" data-ex="{{ei}}" data-field="restMin" bindinput="onCardioInput" bindblur="persistWorkout" />
                <text class="time-unit">分</text>
                <input class="time-input num" type="number" value="{{exercise.cardio.restSecPart}}" data-ex="{{ei}}" data-field="restSecPart" bindinput="onCardioInput" bindblur="persistWorkout" />
                <text class="time-unit">秒</text>
              </view>
            </view>
          </view>
          <view wx:if="{{exercise.cardio.mode === 'interval' && exercise.cardioMeta.showDistance}}" class="cardio-field mt-12">
            <view class="field-label">距离 (km)</view>
            <input class="compact-input num" type="digit" value="{{exercise.cardio.distanceKmDisplay}}" data-ex="{{ei}}" data-field="distanceKm" bindinput="onCardioInput" bindblur="persistWorkout" />
          </view>

          <view class="cardio-extra mt-16">
            <view wx:if="{{exercise.cardioMeta.showIncline}}" class="mini-field">
              <view class="field-label">坡度</view>
              <input class="compact-input num" type="digit" value="{{exercise.cardio.inclineDisplay}}" data-ex="{{ei}}" data-field="incline" bindinput="onCardioInput" bindblur="persistWorkout" />
            </view>
            <view wx:if="{{exercise.cardioMeta.showAvgIncline}}" class="mini-field">
              <view class="field-label">平均坡度</view>
              <input class="compact-input num" type="digit" value="{{exercise.cardio.avgInclineDisplay}}" data-ex="{{ei}}" data-field="avgIncline" bindinput="onCardioInput" bindblur="persistWorkout" />
            </view>
            <view wx:if="{{exercise.cardioMeta.showAvgSpeed}}" class="mini-field">
              <view class="field-label">平均速度 km/h</view>
              <input class="compact-input num" type="digit" value="{{exercise.cardio.avgSpeedDisplay}}" data-ex="{{ei}}" data-field="avgSpeed" bindinput="onCardioInput" bindblur="persistWorkout" />
            </view>
            <view wx:if="{{exercise.cardioMeta.showLevel}}" class="mini-field">
              <view class="field-label">阻力/档位</view>
              <input class="compact-input num" type="number" value="{{exercise.cardio.level}}" data-ex="{{ei}}" data-field="level" bindinput="onCardioInput" bindblur="persistWorkout" />
            </view>
            <view wx:if="{{exercise.cardioMeta.showCadence}}" class="mini-field">
              <view class="field-label">踏频 rpm</view>
              <input class="compact-input num" type="number" value="{{exercise.cardio.cadence}}" data-ex="{{ei}}" data-field="cadence" bindinput="onCardioInput" bindblur="persistWorkout" />
            </view>
            <view wx:if="{{exercise.cardioMeta.showStrokeRate}}" class="mini-field">
              <view class="field-label">桨频 spm</view>
              <input class="compact-input num" type="number" value="{{exercise.cardio.strokeRate}}" data-ex="{{ei}}" data-field="strokeRate" bindinput="onCardioInput" bindblur="persistWorkout" />
            </view>
            <view wx:if="{{exercise.cardioMeta.showAvgPower}}" class="mini-field">
              <view class="field-label">平均功率 W</view>
              <input class="compact-input num" type="number" value="{{exercise.cardio.avgPower}}" data-ex="{{ei}}" data-field="avgPower" bindinput="onCardioInput" bindblur="persistWorkout" />
            </view>
            <view wx:if="{{exercise.cardioMeta.showDamper}}" class="mini-field">
              <view class="field-label">阻力档位</view>
              <input class="compact-input num" type="number" value="{{exercise.cardio.damper}}" data-ex="{{ei}}" data-field="damper" bindinput="onCardioInput" bindblur="persistWorkout" />
            </view>
            <view wx:if="{{exercise.cardioMeta.showCount}}" class="mini-field">
              <view class="field-label">次数</view>
              <input class="compact-input num" type="number" value="{{exercise.cardio.count}}" data-ex="{{ei}}" data-field="count" bindinput="onCardioInput" bindblur="persistWorkout" />
            </view>
            <view wx:if="{{exercise.cardioMeta.showMisses}}" class="mini-field">
              <view class="field-label">中断次数</view>
              <input class="compact-input num" type="number" value="{{exercise.cardio.misses}}" data-ex="{{ei}}" data-field="misses" bindinput="onCardioInput" bindblur="persistWorkout" />
            </view>
            <view wx:if="{{exercise.cardioMeta.showPoolLength}}" class="mini-field">
              <view class="field-label">泳池长度 m</view>
              <input class="compact-input num" type="number" value="{{exercise.cardio.poolLength}}" data-ex="{{ei}}" data-field="poolLength" bindinput="onCardioInput" bindblur="persistWorkout" />
            </view>
            <view wx:if="{{exercise.cardioMeta.showStroke}}" class="mini-field">
              <view class="field-label">泳姿</view>
              <input class="compact-input" value="{{exercise.cardio.strokeType}}" data-ex="{{ei}}" data-field="strokeType" bindinput="onCardioInput" bindblur="persistWorkout" />
            </view>
          </view>

          <view wx:if="{{exercise.cardio.mode === 'interval'}}" class="cardio-total mt-12">
            <view class="tiny muted">总时长</view>
            <view class="cardio-total-value num">{{exercise.cardio.durationLabel}}</view>
          </view>

          <view class="cardio-extra mt-12">
            <view class="mini-field">
              <view class="field-label">平均心率 bpm</view>
              <input class="compact-input num" type="number" value="{{exercise.cardio.avgHeartRate}}" data-ex="{{ei}}" data-field="avgHeartRate" bindinput="onCardioInput" bindblur="persistWorkout" />
            </view>
            <view class="mini-field">
              <view class="field-label">热量 kcal</view>
              <input class="compact-input num" type="number" value="{{exercise.cardio.calories}}" data-ex="{{ei}}" data-field="calories" bindinput="onCardioInput" bindblur="persistWorkout" />
              <view wx:if="{{exercise.cardioType === 'treadmill_incline' || exercise.cardioType === 'treadmill_run'}}" class="cardio-field-hint">
                {{profileWeightKg ? '修改坡度、速度或时长后自动重算，可手动修改' : '填写个人信息中的体重后自动估算'}}
              </view>
            </view>
          </view>

          <view wx:if="{{exercise.cardio.summary}}" class="cardio-summary mt-16">
            {{exercise.cardio.summary}}
          </view>
        </block>

        <block wx:else>
          <view class="set-head mt-16">
            <view class="set-index">组</view>
            <block wx:if="{{exercise.type === 'weight_reps'}}">
              <view class="set-field-label">重量 ({{unit}})</view>
              <view class="set-field-label">次数</view>
            </block>
            <block wx:elif="{{exercise.type === 'reps'}}">
              <view class="set-field-label set-field-label-wide">次数</view>
            </block>
            <block wx:else>
              <view class="set-field-label set-field-label-wide">时长 (秒)</view>
            </block>
            <view class="set-check-label">完成</view>
            <view class="set-delete-space"></view>
          </view>

          <block wx:for="{{exercise.sets}}" wx:key="id" wx:for-item="set" wx:for-index="si">
            <view class="set-row {{set.completed ? 'done' : ''}}">
              <view class="set-index num">{{si + 1}}</view>

              <block wx:if="{{exercise.type === 'weight_reps'}}">
                <view class="set-field">
                  <view class="step-btn" data-ex="{{ei}}" data-set="{{si}}" data-field="weight" data-delta="-2.5" catchtap="stepSet">−</view>
                  <input class="set-input num" type="digit" value="{{set.weightDisplay}}" data-ex="{{ei}}" data-set="{{si}}" data-field="weight" bindinput="onSetInput" bindblur="onSetBlur" />
                  <view class="step-btn" data-ex="{{ei}}" data-set="{{si}}" data-field="weight" data-delta="2.5" catchtap="stepSet">+</view>
                </view>
                <view class="set-field">
                  <view class="step-btn" data-ex="{{ei}}" data-set="{{si}}" data-field="reps" data-delta="-1" catchtap="stepSet">−</view>
                  <input class="set-input num" type="number" value="{{set.reps}}" data-ex="{{ei}}" data-set="{{si}}" data-field="reps" bindinput="onSetInput" bindblur="onSetBlur" />
                  <view class="step-btn" data-ex="{{ei}}" data-set="{{si}}" data-field="reps" data-delta="1" catchtap="stepSet">+</view>
                </view>
              </block>

              <block wx:elif="{{exercise.type === 'reps'}}">
                <view class="set-field set-field-wide">
                  <view class="step-btn" data-ex="{{ei}}" data-set="{{si}}" data-field="reps" data-delta="-1" catchtap="stepSet">−</view>
                  <input class="set-input num" type="number" value="{{set.reps}}" data-ex="{{ei}}" data-set="{{si}}" data-field="reps" bindinput="onSetInput" bindblur="onSetBlur" />
                  <view class="step-btn" data-ex="{{ei}}" data-set="{{si}}" data-field="reps" data-delta="1" catchtap="stepSet">+</view>
                </view>
              </block>

              <block wx:else>
                <view class="set-field set-field-wide">
                  <view class="step-btn" data-ex="{{ei}}" data-set="{{si}}" data-field="duration" data-delta="-15" catchtap="stepSet">−</view>
                  <input class="set-input num" type="number" value="{{set.duration}}" data-ex="{{ei}}" data-set="{{si}}" data-field="duration" bindinput="onSetInput" bindblur="onSetBlur" />
                  <view class="step-btn" data-ex="{{ei}}" data-set="{{si}}" data-field="duration" data-delta="15" catchtap="stepSet">+</view>
                </view>
              </block>

              <view class="check-btn {{set.completed ? 'checked' : ''}}" data-ex="{{ei}}" data-set="{{si}}" bindtap="toggleSet">
                {{set.completed ? '✓' : ''}}
              </view>
              <view class="set-delete" data-ex="{{ei}}" data-set="{{si}}" catchtap="removeSet">×</view>
            </view>
          </block>
        </block>

        <view class="exercise-actions mt-16">
          <button wx:if="{{!exercise.isCardio}}" class="mini-action" data-ex="{{ei}}" catchtap="addSet">＋ 添加一组</button>
          <button class="mini-action ghost" data-ex="{{ei}}" bindtap="toggleExerciseNote">{{exercise.showNote ? '收起备注' : '备注'}}</button>
        </view>

        <textarea wx:if="{{exercise.showNote}}" class="note-input mt-12" placeholder="这个动作的感觉、姿势或器械设置..." placeholder-class="input-placeholder" value="{{exercise.note}}" data-ex="{{ei}}" bindinput="onExerciseNoteInput" bindblur="persistWorkout" />
      </view>
    </block>

    <button wx:if="{{workout.exercises.length}}" class="btn btn-ghost btn-block mt-24" bindtap="addExercise">＋ 添加动作</button>

    <view class="card session-note mt-24">
      <view class="section-title">训练备注</view>
      <textarea class="note-input mt-12" placeholder="今天的状态、疼痛、器械调整..." placeholder-class="input-placeholder" value="{{workout.note}}" bindinput="onWorkoutNoteInput" bindblur="persistWorkout" />
    </view>
  </view>

  <view class="sticky-bottom workout-bottom">
    <view wx:if="{{restActive}}" class="rest-bar">
      <view class="row between">
        <view class="row gap-10">
          <view class="rest-dot"></view>
          <view>
            <view class="rest-label">休息 {{restLabel}}</view>
            <view class="tiny muted">前台计时 · 可保持亮屏</view>
          </view>
        </view>
        <view class="row gap-8">
          <view class="rest-btn" data-action="minus" bindtap="adjustRest">-15s</view>
          <view class="rest-btn" data-action="plus" bindtap="adjustRest">+15s</view>
          <view class="rest-btn skip" data-action="skip" bindtap="adjustRest">跳过</view>
        </view>
      </view>
    </view>
    <button class="btn btn-primary btn-block mt-12" bindtap="finishWorkout">{{isEditing ? '保存修改' : '结束训练'}}</button>
  </view>
</view>
