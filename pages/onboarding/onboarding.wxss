.onboarding {
  padding-top: 48rpx;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 42rpx;
}

.brand-mark {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
  background: var(--primary);
  color: var(--primary-ink);
  font-size: 54rpx;
  font-weight: 800;
  box-shadow: 0 18rpx 50rpx rgba(199, 255, 61, 0.16);
}

.brand-name {
  margin-top: 24rpx;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.brand-sub {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 25rpx;
}

.welcome-card {
  padding: 36rpx 32rpx;
}

.setting-block {
  margin-top: 34rpx;
}

.goal-stepper {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx;
  border-radius: 22rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--border);
}

.goal-step {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--surface);
  color: var(--text-2);
  font-size: 34rpx;
  font-weight: 600;
}

.goal-value {
  width: 64rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 750;
}

.skip {
  padding: 28rpx 0 8rpx;
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
}

.onboarding-foot {
  padding: 36rpx 24rpx 0;
  text-align: center;
}

.segment:active,
.goal-step:active,
.chip:active {
  opacity: 0.78;
}

.welcome-card .btn-primary {
  margin-top: 28rpx;
}
